# Contains raw Apify API key — never commit
.mcp.json

# Research data: ZoomInfo-derived contact info + Gong/CRM notes.
# Never push to GitHub (third-party sharing / ZI ToS); regenerable by the pipeline.
# data/* (not data/) so the personas config below can be re-included — git
# cannot un-ignore a file whose parent directory is excluded.
data/*
!data/personas.js
# Hand-curated Groove-name -> research-slug map. Config, not research data:
# no contact info in it, and losing it silently un-grounds drafts.
!data/account-aliases.json

node_modules/
dist/
.env
.env.*
*.log
.DS_Store
logs/
.claude/settings.local.json
.playwright-mcp/

# Session scratch: raw CRM/Groove pulls, Playwright page snapshots, one-off
# scripts. Contains contact data, so it stays local like data/*.
.outreach-work/
server/scripts/tmp-outreach/
server/scripts/tmp-*.mjs
/hireart-company.yml
/li-search-*.txt
